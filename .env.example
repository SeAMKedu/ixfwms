# Copy to .env and adjust per environment (laptop, test server, lab box). All optional.

# Base URL printed into QR labels and handed to AI clients. Leave empty to use whatever
# host each request arrives on (handy while the final hostname isn't settled).
# Set it before printing labels for real, e.g. https://ixf.local or https://ixf.internal
IXF_PUBLIC_URL=

# Set to true when running behind Caddy or another reverse proxy.
IXF_TRUST_PROXY=false

# Names and IPs Caddy serves (docker compose --profile https). compose.yaml also points
# IXF_CA_CERT at Caddy's root certificate so phones can download it on the setup page.
IXF_SITE_ADDRESSES=localhost

# Host port for plain HTTP.
IXF_HTTP_PORT=3000

# Nightly backup hour (0-23, server local time, -1 = off) and how many to keep.
IXF_BACKUP_HOUR=3
IXF_BACKUP_KEEP=14

IXF_LOG_LEVEL=info
IXF_MAX_UPLOAD_MB=100

# Outside Docker only: where the database, files and backups live (default ./data).
# IXF_DATA_DIR=./data
# IXF_PORT=3000
