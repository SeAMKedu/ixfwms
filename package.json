{
  "name": "ixfwms",
  "version": "0.0.0",
  "private": true,
  "description": "Lab inventory / warehouse management for the robotics lab",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run dev -w @ixfwms/server",
    "build": "npm run build -w @ixfwms/domain && npm run build -w @ixfwms/server",
    "start": "npm run start -w @ixfwms/server",
    "cli": "npm run cli -w @ixfwms/server --",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --project unit --project integration --coverage",
    "db:generate": "npm run db:generate -w @ixfwms/server",
    "check": "node scripts/check.mjs check",
    "check:patch": "node scripts/check.mjs patch",
    "check:release": "node scripts/check.mjs release",
    "release": "node scripts/release.mjs",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "git-cliff": "^2.14.2",
    "globals": "^17.13.0",
    "knip": "^6.42.1",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "lefthook@2.2.2": true
  }
}
